# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NASA Earthdata User Token: For automated NASA GPM IMERG satellite rainfall ingestion
NASA_EARTHDATA_TOKEN=""

# Tomorrow.io Weather API Key: For temporary live external precipitation ingestion
TOMORROW_API_KEY=""

# IMD Official DWR API Key (when government approval is granted)
IMD_API_KEY=""
IMD_API_URL=""

# MOSDAC Account Credentials (when NRT privileges are approved)
MOSDAC_USERNAME=""
MOSDAC_PASSWORD=""

# Deployment Rainfall Source Priority Profile: 'development' (Tomorrow.io -> GPM -> Replay) or 'official' (IMD -> MOSDAC -> GPM -> Replay)
RAINFALL_SOURCE_PROFILE="development"

# Neon Serverless Postgres Database URL (PostgreSQL + PostGIS Support)
DATABASE_URL="postgresql://neondb_owner:npg_ueX7iTE2Qjpo@ep-royal-silence-b34de2v0-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

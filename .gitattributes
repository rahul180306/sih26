# Treat all files as binary by default to prevent line ending changes
* text=auto

# Explicitly mark image and binary formats as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.ogg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
